{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fiction-factory/schemas/profiles/genre_profile",
  "title": "GenreProfile",
  "description": "Genre module configuration: structural conventions, trope library, quality gates, and reader contract (core-ontology-v3 §9).",
  "type": "object",
  "required": ["profile_id", "version", "genre_name", "genre_module_status", "scene_function_vocabulary", "structural_conventions"],
  "additionalProperties": false,
  "properties": {
    "profile_id": { "type": "string" },
    "version": { "type": "string" },
    "genre_name": { "type": "string" },
    "genre_module_status": {
      "type": "string",
      "enum": ["validated", "scaffold", "experimental"],
      "description": "validated = production-ready; scaffold = structure exists, not tuned; experimental = prototype."
    },

    "scene_function_vocabulary": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Allowed scene function labels for this genre (e.g. setup_tension, meet_cute, black_moment)."
    },

    "required_scene_slots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slot_id", "description", "required"],
        "additionalProperties": false,
        "properties": {
          "slot_id": { "type": "string" },
          "description": { "type": "string" },
          "target_chapter_range": {
            "type": "object",
            "required": ["min", "max"],
            "properties": {
              "min": { "type": "integer", "minimum": 1 },
              "max": { "type": "integer", "minimum": 1 }
            }
          },
          "required": { "type": "boolean" }
        }
      }
    },

    "quality_gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["gate_id", "metric", "threshold", "operator"],
        "additionalProperties": false,
        "properties": {
          "gate_id": { "type": "string" },
          "metric": { "type": "string" },
          "threshold": { "type": "number" },
          "operator": { "type": "string", "enum": ["gte", "lte", "gt", "lt", "eq"] },
          "description": { "type": "string" }
        }
      }
    },

    "self_audit_rubric": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item_id", "question", "weight"],
        "additionalProperties": false,
        "properties": {
          "item_id": { "type": "string" },
          "question": { "type": "string" },
          "weight": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      },
      "description": "Rubric items for the self-audit critic after each scene."
    },

    "heat_scale": {
      "type": "object",
      "description": "Genre-defined intimacy intensity scale.",
      "required": ["min", "max"],
      "additionalProperties": false,
      "properties": {
        "min": { "type": "integer", "minimum": 1 },
        "max": { "type": "integer", "minimum": 1 },
        "anchor_definitions": {
          "type": "object",
          "description": "Map of integer level → label.",
          "additionalProperties": { "type": "string" }
        }
      }
    },

    "structural_conventions": {
      "type": "object",
      "required": ["word_count_range", "chapter_count_range"],
      "additionalProperties": false,
      "properties": {
        "word_count_range": {
          "type": "object",
          "required": ["min", "max"],
          "properties": {
            "min": { "type": "integer", "minimum": 1 },
            "max": { "type": "integer", "minimum": 1 }
          }
        },
        "chapter_count_range": {
          "type": "object",
          "required": ["min", "max"],
          "properties": {
            "min": { "type": "integer", "minimum": 1 },
            "max": { "type": "integer", "minimum": 1 }
          }
        },
        "act_structure": {
          "type": "string",
          "description": "e.g. three_act, four_act, hero_journey, save_the_cat."
        },
        "pov_default": {
          "type": "string",
          "enum": ["first_person", "close_third", "omniscient", "multiple_pov"]
        },
        "tense_default": {
          "type": "string",
          "enum": ["past", "present"]
        }
      }
    },

    "heat_curve": {
      "type": "string",
      "enum": ["rising", "steep", "plateau", "flat"],
      "description": "Pacing pattern for intimacy intensity across the book (rising=gradual build, steep=fast early escalation)."
    },

    "interiority_budget_pct_max": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Maximum share of words devoted to internal monologue / interiority."
    },

    "exposition_budget_pct_max": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Maximum share of words devoted to exposition."
    },

    "sex_scene_frequency_min": {
      "type": "string",
      "description": "Minimum sex scene frequency constraint (e.g. '1_per_3_chapters')."
    },

    "escalation_rules": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Rules governing act_type escalation across sex scenes (e.g. no_repeated_act_within_3_scenes)."
    },

    "trope_library": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["trope_id", "name"],
        "additionalProperties": false,
        "properties": {
          "trope_id": { "type": "string" },
          "name": { "type": "string" },
          "category": {
            "type": "string",
            "enum": ["must_have", "commonly_loved", "taboo", "fresh_twist"]
          },
          "required_beats": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },

    "reader_contract": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Promise types that must be opened and resolved (e.g. romantic_tension, hea_or_hfn)."
    }
  }
}
