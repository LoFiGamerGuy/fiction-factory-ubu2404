{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fiction-factory/schemas/profiles/audience_profile",
  "title": "AudienceProfile",
  "description": "Reader lens, tolerance bands, expectations, and reader personas (core-ontology-v3 §10).",
  "type": "object",
  "required": ["profile_id", "version", "reader_lens", "tolerance_bands", "expectation_set", "trigger_sets"],
  "additionalProperties": false,
  "properties": {
    "profile_id": { "type": "string" },
    "version": { "type": "string" },

    "reader_lens": {
      "type": "string",
      "description": "Plain-language description of the primary reader's perspective and expectations."
    },

    "tolerance_bands": {
      "type": "object",
      "description": "Per-dimension tolerance range (0–1) the audience will accept without DNF.",
      "additionalProperties": {
        "type": "object",
        "required": ["min", "max"],
        "properties": {
          "min": { "type": "number", "minimum": 0, "maximum": 1 },
          "max": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      },
      "examples": [{"complexity": {"min": 0.2, "max": 0.7}, "darkness": {"min": 0.0, "max": 0.6}}]
    },

    "expectation_set": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Explicit expectations this audience brings (e.g. hea_required, no_cliffhanger_endings)."
    },

    "trigger_sets": {
      "type": "object",
      "required": ["dnf_triggers", "satisfaction_triggers"],
      "additionalProperties": false,
      "properties": {
        "dnf_triggers": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Conditions that cause this audience to DNF (e.g. hero_dies, no_resolution)."
        },
        "satisfaction_triggers": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Elements that guarantee re-read / recommendation (e.g. earned_hea, banter)."
        }
      }
    },

    "reader_personas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["persona_id", "name", "description"],
        "additionalProperties": false,
        "properties": {
          "persona_id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "weight": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Relative weight in aggregate reader satisfaction score."
          },
          "reading_preferences": {
            "type": "object",
            "description": "Key-value pairs of this persona's specific preferences.",
            "additionalProperties": { "type": ["string", "number", "boolean"] }
          }
        }
      }
    }
  }
}
