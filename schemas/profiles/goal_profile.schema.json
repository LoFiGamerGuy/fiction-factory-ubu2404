{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fiction-factory/schemas/profiles/goal_profile",
  "title": "GoalProfile",
  "description": "Intent-specific overlay governing conflict resolution and convergence tuning (core-ontology-v3 §13).",
  "type": "object",
  "required": ["profile_id", "version", "intent", "conflict_precedence_rules", "success_criteria"],
  "additionalProperties": false,
  "properties": {
    "profile_id": { "type": "string" },
    "version": { "type": "string" },

    "intent": {
      "type": "string",
      "enum": ["kdp_high_revenue", "literary_award_target", "personal_vanity", "series_brand"],
      "description": "Primary publishing intent driving all convergence decisions."
    },

    "conflict_precedence_rules": {
      "type": "array",
      "description": "Per-axis precedence overrides. Sensitivity always wins on sensitivity axes regardless of these rules.",
      "items": {
        "type": "object",
        "required": ["axis", "precedence_order"],
        "additionalProperties": false,
        "properties": {
          "axis": { "type": "string", "description": "e.g. max_heat_level, word_count, pov_distance." },
          "precedence_order": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["sensitivity", "goal", "genre", "audience", "author", "universal"]
            },
            "description": "First profile in list wins the conflict for this axis."
          }
        }
      }
    },

    "weight_overrides": {
      "type": "object",
      "description": "Convergence weight overrides for critics and readers.",
      "additionalProperties": false,
      "properties": {
        "critic_weights": {
          "type": "object",
          "additionalProperties": { "type": "number", "minimum": 0 }
        },
        "reader_weights": {
          "type": "object",
          "additionalProperties": { "type": "number", "minimum": 0 }
        }
      }
    },

    "success_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["criterion_id", "metric", "threshold", "operator"],
        "additionalProperties": false,
        "properties": {
          "criterion_id": { "type": "string" },
          "metric": { "type": "string" },
          "threshold": { "type": "number" },
          "operator": {
            "type": "string",
            "enum": ["gte", "lte", "gt", "lt", "eq"]
          },
          "description": { "type": "string" }
        }
      }
    }
  }
}
