{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fiction-factory/schemas/profiles/sensitivity_profile",
  "title": "SensitivityProfile",
  "description": "Content sensitivity policy. Sacred: Goal cannot loosen hard_thresholds (core-ontology-v3 §12).",
  "type": "object",
  "required": ["profile_id", "version", "content_domain_policies", "hard_thresholds", "sacred", "audience_markers"],
  "additionalProperties": false,
  "properties": {
    "profile_id": { "type": "string" },
    "version": { "type": "string" },
    "sacred": {
      "type": "boolean",
      "const": true,
      "description": "Always true. Marks that Goal cannot loosen this profile's hard_thresholds."
    },

    "content_domain_policies": {
      "type": "object",
      "description": "Map of content domain → policy.",
      "additionalProperties": {
        "type": "string",
        "enum": ["allow", "allow_with_constraints", "prohibit"]
      },
      "examples": [{
        "sexual_content": "allow",
        "graphic_violence": "allow_with_constraints",
        "child_harm": "prohibit",
        "self_harm": "prohibit"
      }]
    },

    "vocabulary_restrictions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["term_or_regex", "restriction_level"],
        "additionalProperties": false,
        "properties": {
          "term_or_regex": { "type": "string" },
          "restriction_level": {
            "type": "string",
            "enum": ["prohibited", "flagged"],
            "description": "prohibited = never output; flagged = critic review required."
          },
          "notes": { "type": "string" }
        }
      }
    },

    "audience_markers": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Applicable audience labels (e.g. adult_unrestricted, ya_safe, new_adult)."
    },

    "hard_thresholds": {
      "type": "object",
      "description": "Sacred numeric thresholds that cannot be loosened by Goal profile. x-sacred: true.",
      "x-sacred": true,
      "additionalProperties": {
        "type": "number"
      },
      "examples": [{"max_heat_level": 5, "max_violence_intensity": 4}]
    },

    "auto_content_warnings": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Content warning strings auto-injected into the publication package."
    },

    "representation_policy": {
      "type": "object",
      "description": "Policies for marginalized group depiction.",
      "properties": {
        "authenticity_requirements": { "type": "array", "items": { "type": "string" } },
        "language_restrictions": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
